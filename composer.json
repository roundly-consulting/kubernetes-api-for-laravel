{
    "name": "roundly-consulting/kubernetes-api-for-laravel",
    "description": "A fluent, Eloquent-style client for the Kubernetes API in Laravel.",
    "keywords": [
        "Roundly Consulting",
        "laravel",
        "kubernetes",
        "kubernetes-api",
        "traefik"
    ],
    "homepage": "https://github.com/roundly-consulting/kubernetes-api-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http-client-rate-limits-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/http-client-rate-limits-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "@dev",
        "roundly-consulting/http-client-rate-limits-for-laravel": "@dev",
        "roundly-consulting/package-toolkit-for-laravel": "@dev",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\KubernetesApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\KubernetesApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "test-integration": "vendor/bin/pest --group=integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\KubernetesApi\\KubernetesApiServiceProvider"
            ],
            "aliases": {
                "Kubernetes": "RoundlyConsulting\\KubernetesApi\\Facades\\Kubernetes"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
